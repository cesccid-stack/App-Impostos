{
  "name": "hacienda-renta",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "test:renta": "node --experimental-strip-types scripts/verify-renta.ts",
    "test": "node --experimental-strip-types scripts/verify-renta.ts",
    "index": "node --experimental-strip-types scripts/generate-index.ts"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.11.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.2"
  }
}
